# research/.env — ключи для оффлайн-бенчмарка. Скопируй в research/.env и впиши свои.
# Файл research/.env в .gitignore — секреты не попадут в git.
# Подхватывается так:  set -a; source research/.env; set +a   (см. README)

# --- Парсинг PDF → json+bbox (шаг parse_corpus) ---------------------------
# Ключ Datalab. Нужен, только если нет сохранённого json и парсим PDF заново.
APP_DATALAB_API_KEY=

# --- LLM для генерации QA (шаг generate_qa) через OpenRouter --------------
# OpenRouter — OpenAI-совместимый endpoint. Модель — любая доступная тебе.
APP_LLM_API_KEY=
APP_LLM_BASE_URL=https://openrouter.ai/api/v1
APP_LLM_MODEL=openai/gpt-4o-mini

# --- Эмбеддинги (шаг run_retrieval) ---------------------------------------
# Вариант по умолчанию — локальная модель (--provider local): ключ НЕ нужен,
# ничего сюда вписывать не надо. Заполни ниже, только если хочешь Voyage/OpenAI.
APP_VOYAGE_API_KEY=
APP_OPENAI_API_KEY=
